# Скопируйте в .env.local и заполните. После изменений перезапустите сервер.

# Google Cloud Console → Credentials → OAuth client ID (Web application).
# В "Authorized redirect URIs" добавьте: <адрес сайта>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail владельца канала — только этот аккаунт сможет подключиться.
ADMIN_EMAIL=

# Случайная строка от 32 символов: шифрует хранилище и подписывает сессии.
# Сгенерировать: openssl rand -base64 48
APP_SECRET=

# Публичный адрес сайта (нужен, если сайт за прокси/доменом). Иначе — из запроса.
APP_URL=
